# ============================================================================
# TomoMatcha · variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo como `.env.local` para desarrollo, y pon los mismos
# valores en el panel de tu hosting (Vercel → Settings → Environment Variables)
# para producción.
#
# Después de llenarlo, ejecuta `npm run doctor` para comprobar las conexiones.
# El paso a paso para obtener cada valor está en INSTRUCCIONES.md.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Supabase · base de datos                                    OBLIGATORIO
# ---------------------------------------------------------------------------
# Panel de Supabase → Project Settings → API
#
# La llave `service_role` es SECRETA: da acceso total a la base y salta RLS.
# Sólo se usa en el servidor; nunca la pongas en una variable NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. La aplicación no la necesita (nunca habla con Supabase desde el
# navegador), pero si la pones, `npm run doctor` comprueba que esa llave
# pública efectivamente NO tenga acceso a nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 2. Clerk · autenticación                                       OBLIGATORIO
# ---------------------------------------------------------------------------
# Panel de Clerk → API Keys. Las dos llaves tienen que ser de la MISMA
# aplicación y del mismo entorno (las dos de test, o las dos de producción).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Correos que entran directo como administradores activos, separados por coma.
# Sin esto, el primer usuario que inicie sesión queda como administrador y los
# demás se quedan esperando autorización.
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# 3. Cloudflare R2 · imágenes y media                               OPCIONAL
# ---------------------------------------------------------------------------
# Sin esto la aplicación funciona completa; sólo se desactiva la subida de
# fotos de productos y del logo (la interfaz lo avisa).
#
# Cloudflare → R2 → Manage API tokens → Create API token (permiso de
# lectura y escritura de objetos sobre el bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tomomatcha-media

# Dominio público del bucket (r2.dev o un dominio propio). Recomendado: las
# imágenes se sirven cacheadas desde Cloudflare en lugar de pasar por la
# aplicación. Sin él, se sirven por /api/media/... y sólo las ven usuarios con
# sesión.
R2_PUBLIC_BASE_URL=

# Sólo si usas un endpoint S3 distinto al estándar de R2.
# R2_ENDPOINT=

# ---------------------------------------------------------------------------
# 4. Aplicación                                                    OPCIONAL
# ---------------------------------------------------------------------------
# Dominio público de la aplicación. En Vercel se detecta solo.
NEXT_PUBLIC_APP_URL=
